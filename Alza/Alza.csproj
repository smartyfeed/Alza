<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- A planning run is a short batch job: compile fully optimised code right away,
             so that the first plan is as fast as the following ones. -->
        <TieredCompilation>false</TieredCompilation>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Alza.Planner\Alza.Planner.csproj" />
    </ItemGroup>

</Project>
